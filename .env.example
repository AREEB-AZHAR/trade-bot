# Required execution mode: backtest, paper, or live.
MODE=backtest

# Comma-separated perpetual-futures symbols. The exchange adapter will validate
# native symbol names when it is added.
SYMBOLS=BTC_USDT

# A strategy must refuse new entries after this many milliseconds without a tick.
STALE_DATA_THRESHOLD_MS=2000

# Fee assumption used by simulation and reporting. 5 bps = 0.05% per side.
TAKER_FEE_BPS=5

# Position sizing is frozen when an order batch begins, so every order in that
# batch receives the same notional policy. Select exactly one of:
# fixed_usd                 - the USDT notional for every order
# account_equity_percent    - the percentage of then-current account equity
POSITION_SIZE_MODE=fixed_usd
POSITION_SIZE_VALUE=100

# Required to run a backtest. Keep local data outside version control.
# CSV schema: timestamp_ms,price
# HISTORICAL_DATA_PATH=./data/BTC_USDT-2026-01-01.csv

# Deliberately absent. Live mode additionally requires this exact value:
# I_UNDERSTAND_THIS_IS_LIVE=true
